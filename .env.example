# 复制为 .env 后再填；.env 已在 .gitignore 中，不会入库。
# 本地和服务器各用一份，值可以不同。

# 项目根目录（一般留 "." 即可，指向仓库根）
MVS_ROOT=.

# HuggingFace 下载走镜像（国内服务器必填，否则卡在 0%）
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=./.cache/huggingface

# 生成模型：vllm_http = 连本地 vLLM 服务；openai = 连付费 API；mock = 不调模型（联调解析逻辑）
MVS_LLM_BACKEND=vllm_http
MVS_LLM_BASE_URL=http://127.0.0.1:8000/v1
MVS_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
MVS_LLM_API_KEY=EMPTY

# 付费 API 兜底（backend=openai 时用）
OPENAI_BASE_URL=
OPENAI_API_KEY=
